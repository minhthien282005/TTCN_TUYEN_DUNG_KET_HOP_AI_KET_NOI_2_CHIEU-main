# Bỏ trống để dùng trợ lý ngữ cảnh nội bộ, không gửi dữ liệu ra dịch vụ AI ngoài.
# Chỉ bật khi đơn vị vận hành đã chấp thuận xử lý dữ liệu qua nhà cung cấp; người dùng vẫn phải đồng ý riêng trong chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Tùy chọn endpoint tương thích OpenAI; mặc định https://api.openai.com/v1/chat/completions
OPENAI_API_URL=
